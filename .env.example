# Voice Live endpoint from the Azure AI Services resource Keys and Endpoint page.
VOICELIVE_ENDPOINT=

# Existing Microsoft Foundry agent and project names.
AGENT_NAME=
PROJECT_NAME=

# Optional: pin a published agent version or resume a conversation.
AGENT_VERSION=
CONVERSATION_ID=

# Avatar and voice. Confirm the character is available in your resource region.
# https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support?tabs=tts
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting
VOICE_NAME=zh-HK-HiuMaanNeural
SPEECH_RECOGNITION_LANGUAGE=zh-HK
INTERIM_RESPONSE_LATENCY_MS=800
GREETING_PROMPT=請全程使用香港粵語回答，文字使用繁體中文。先簡短介紹自己是 Ricoh 產品知識顧問，再問用戶有甚麼可以幫忙。

# Optional only when Voice Live and the agent are on different Foundry resources.
FOUNDRY_RESOURCE_OVERRIDE=
AGENT_AUTHENTICATION_IDENTITY_CLIENT_ID=